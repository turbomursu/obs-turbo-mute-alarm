<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ObsTurboMuteAlarm</AssemblyName>
    <RootNamespace>ObsTurboMuteAlarm</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.0</Version>
    <Product>OBS Turbo Mute Alarm</Product>
    <Company>Mursu-soft</Company>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ObsTurboMuteAlarm.Tests" />
    <InternalsVisibleTo Include="ObsTurboMuteAlarm.Icp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\mursu-soft.png" LogicalName="ObsTurboMuteAlarm.Resources.mursu-soft.png" />
  </ItemGroup>

</Project>
